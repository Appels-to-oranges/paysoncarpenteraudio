---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="logo-icon">◆</span>
      <span>Payson Carpenter Audio</span>
    </div>
    <div class="footer-links">
      <a href="/">Home</a>
      <a href="/extensions">Extensions</a>
      <a href="/max-for-live">Max for Live</a>
    </div>
    <a class="footer-support" href="https://ko-fi.com/paysoncarpenter" target="_blank" rel="noreferrer">Support on Ko-fi</a>
    <p class="footer-copy">&copy; {year} Payson Carpenter Audio. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border-subtle);
    padding: 3rem 0;
    margin-top: 2rem;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1rem;
  }

  .logo-icon {
    color: var(--text-primary);
  }

  .footer-links {
    display: flex;
    gap: 1.5rem;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .footer-links a:hover {
    color: var(--text-primary);
  }

  .footer-copy {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .footer-support {
    font-size: 0.8rem;
    color: var(--text-muted);
    border-bottom: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .footer-support:hover {
    color: var(--text-primary);
    border-color: var(--text-primary);
  }
</style>
